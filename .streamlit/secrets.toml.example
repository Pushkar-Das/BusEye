# BusEye Streamlit Dashboard — Secrets Template
# ---------------------------------------------------
# Go to: share.streamlit.io → Your App → Settings → Secrets
# Paste the content below (filled with your real values)

BACKEND_URL = "https://buseye-backend.onrender.com"

AWS_ACCESS_KEY_ID = "your-aws-access-key"
AWS_SECRET_ACCESS_KEY = "your-aws-secret-key"
AWS_REGION = "ap-south-1"
S3_BUCKET_NAME = "your-s3-bucket-name"
S3_IMAGES_BUCKET = "your-s3-images-bucket-name"
